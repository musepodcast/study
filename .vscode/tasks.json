{
  "version": "2.0.0",
  "tasks": [
    { "label": "Flutter Pub Get", "type": "shell", "command": "flutter", "args": ["pub", "get"], "options": { "cwd": "${workspaceFolder}/app" }, "problemMatcher": [] },
    { "label": "Flutter Analyze", "type": "shell", "command": "flutter", "args": ["analyze"], "options": { "cwd": "${workspaceFolder}/app" }, "problemMatcher": [] },
    { "label": "Flutter Test", "type": "shell", "command": "flutter", "args": ["test"], "options": { "cwd": "${workspaceFolder}/app" }, "problemMatcher": [] },
    { "label": "Build Flutter Web Release", "type": "shell", "command": "flutter", "args": ["build", "web", "--release"], "options": { "cwd": "${workspaceFolder}/app" }, "problemMatcher": [] },
    { "label": "Build GitHub Pages Web Release", "type": "shell", "command": "flutter", "args": ["build", "web", "--release", "--base-href", "/study/", "--no-web-resources-cdn"], "options": { "cwd": "${workspaceFolder}/app" }, "problemMatcher": [] },
    { "label": "Validate Civics Data", "type": "shell", "command": "python", "args": ["tools/validate_data.py"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] }
  ]
